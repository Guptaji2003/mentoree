# Database (PostgreSQL - Neon / Supabase / Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mentorship?schema=public"

# Auth Secrets (Argon2id + Jose HS256)
JWT_SECRET="super_secret_jwt_access_token_encryption_key_at_least_32_chars_long"
JWT_REFRESH_SECRET="super_secret_jwt_refresh_token_encryption_key_at_least_32_chars_long"

# Razorpay Payment Gateway
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_for_hmac_sha256"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"

# AWS S3 for Mentor Verification Documents (Private Bucket)
AWS_ACCESS_KEY_ID="mock_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="mock_aws_secret_access_key"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="mentorship-verification-docs"

# Resend Email Service
RESEND_API_KEY="re_mock_resend_api_key_12345678"
RESEND_FROM_EMAIL="noreply@mentoree.live"

# Cron Secret for Vercel Cron / Slot Hold Release
CRON_SECRET="mentorship_cron_secret_auth_token_9988"

# Optional Upstash Redis for Rate Limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
